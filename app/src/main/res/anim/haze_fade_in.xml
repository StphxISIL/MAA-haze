<?xml version="1.0" encoding="utf-8"?>
<!--
    Entrada de una pestaña (Inicio, Carta, Pedido): aparece de transparente a sólida.
    Reemplaza el deslizamiento de Android, que es para "entrar a otra pantalla", no para cambiar de pestaña.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:fromAlpha="0.0"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:toAlpha="1.0" />
